{
  "name": "guerra-saltana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "pnpm run typecheck && vite build",
    "assets": "tsx scripts/prepare-v2.ts && tsx scripts/prepare-brand.ts && tsx scripts/prepare-ui.ts && tsx scripts/prepare-tero.ts",
    "assets:tero": "tsx scripts/prepare-tero.ts",
    "assets:legacy": "tsx scripts/assets.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^3.90.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
